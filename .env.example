# Copy to .env and fill in real values:
#   cp .env.example .env

# --- Front end ---
# telegram = python-telegram-bot (default)
# session  = Session.js adapter + local Python HTTP bridge
CHAT_BACKEND=telegram

# --- Telegram (required when CHAT_BACKEND=telegram) ---
# From @BotFather (/newbot)
TELEGRAM_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# From @userinfobot (numeric Telegram user id)
ALLOWED_USER_ID=123456789

# --- Session (required when CHAT_BACKEND=session) ---
# Recovery phrase for the bot's Session identity (keep secret)
SESSION_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13
SESSION_DISPLAY_NAME=PrivateAI
# Your personal Session ID(s), comma-separated — only these may talk to the bot
SESSION_ALLOWED_ID=05your_session_id_here
# Python bridge the Session.js adapter calls
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
# Optional shared secret; set the same value in both processes
BRIDGE_TOKEN=
AGENT_BRIDGE_URL=http://127.0.0.1:8787
SESSION_STORAGE_PATH=/home/jthornto/Documents/projects/PrivateAI/data/session-adapter/storage.db
SESSION_MESSAGE_CHUNK=1800

# --- Ollama ---
# Model tag as shown by `ollama list`
OLLAMA_MODEL=qwen2.5-coder:7b
# Local Ollama, or remote GPU host
OLLAMA_HOST=http://127.0.0.1:11434
# Hard timeout for a single Ollama chat call (seconds)
OLLAMA_TIMEOUT_SECONDS=180
# Warn in logs this often while still waiting for a chat response
OLLAMA_STUCK_WARN_SECONDS=30
# 0 = disable model thinking/reasoning (faster); 1 = enable
OLLAMA_THINK=0
# Max tokens generated per chat call (-1 = uncapped / Ollama default)
OLLAMA_NUM_PREDICT=-1
# Optional context window override in tokens (empty = model default)
OLLAMA_NUM_CTX=
# Auto-continue when Ollama stops with done_reason=length
OLLAMA_MAX_CONTINUATIONS=2
# If a chat call fails because Ollama dropped the connection / restarted, wait up
# to this many seconds for /api/version to answer (polling every
# OLLAMA_RETRY_POLL_SECONDS), then retry the call once
OLLAMA_RETRY_WAIT_SECONDS=90
OLLAMA_RETRY_POLL_SECONDS=2

# --- MCP tools ---
# Path to local MCP server config (gitignored)
MCP_CONFIG_PATH=/home/jthornto/Documents/projects/PrivateAI/mcp.json
# Max model↔tool loops per user message
MAX_TOOL_ITERATIONS=8
# 1 = hide write/edit/move/create tools (recommended); 0 = allow them
MCP_READONLY=1
# Comma-separated tools to expose to the model (applied on top of MCP_READONLY).
# Match either the registered name (filesystem_read_text_file) or the server-local
# name (read_text_file), case-insensitive. "all" or "*" = every tool; empty = the
# built-in default (read_text_file, read_multiple_files, write_file, edit_file,
# create_directory, list_directory, directory_tree, move_file, search_files).
# Fewer tools = a smaller prompt = faster replies.
MCP_TOOL_ALLOWLIST=
# Max characters of each tool description / each parameter description sent to
# Ollama (cut at a sentence or word boundary). 0 = send the full text.
MCP_TOOL_DESC_MAX_CHARS=200
MCP_PARAM_DESC_MAX_CHARS=80
# auto   = send tool schemas only when the message looks like it needs file access
#          (keywords such as file/read/list/save, a path, or a file extension),
#          plus short follow-ups; plain chat gets a much smaller, faster prompt
# always = send tools on every request; never = never send tools
# Per chat you can override this with /tools auto|on|off|reset.
TOOL_ROUTING=auto
# In auto mode, keep tools on for follow-up messages this long (seconds) after a
# turn that needed files or called a tool
TOOL_ROUTING_FOLLOWUP_SECONDS=600

# --- Durable conversation memory ---
# Per-chat transcript + rolling summary directory
MEMORY_DIR=/home/jthornto/Documents/projects/PrivateAI/data/sessions
# How many recent user/assistant turns to inject into each prompt
MEMORY_RECENT_TURNS=4
# Summarize to disk after this many completed turns
MEMORY_SUMMARIZE_EVERY=6
# Soft character budget for summary + recent turns in the prompt
MEMORY_MAX_CONTEXT_CHARS=12000

# --- Conversation RAG ---
# 1 = retrieve relevant older turns via embeddings; 0 = disable
RAG_ENABLED=1
# Per-session SQLite vector store directory
RAG_DIR=/home/jthornto/Documents/projects/PrivateAI/data/rag
# Embedding model on the same OLLAMA_HOST (ollama pull nomic-embed-text)
RAG_EMBED_MODEL=nomic-embed-text
# GPU layers for the embedding model: 0 = CPU only (default; keeps the iGPU
# free for the chat model), -1 or empty = let Ollama decide, N = offload N layers
RAG_EMBED_NUM_GPU=0
# How many past chunks to inject into each prompt
RAG_TOP_K=4
# Soft character budget for retrieved snippets
RAG_MAX_CONTEXT_CHARS=4000
# Drop weak cosine matches below this score
RAG_MIN_SCORE=0.25

# --- External memory service (shadow mode) ---
# The memory-service container (docker-compose.yml) archives a copy of every completed
# turn and answers a recall query per turn whose result is only LOGGED. Replies,
# prompts and tools stay exactly as before. See README "Memory service (shadow mode)".
# Shared secret between the bot and the memory-service container. Generate with:
#   openssl rand -hex 24
MEMORY_TOKEN=
# legacy = rolling summary + RAG (default); service = core-only context (fact profile +
# last N turns, no summary/RAG). Keep legacy until the shadow logs look good.
MEMORY_BACKEND=legacy
# Memory service base URL on the compose network. Empty disables the integration when
# running the bot outside Docker (Compose itself always falls back to this value)
MEMORY_SERVICE_URL=http://memory-service:8765
# off = no recall; shadow = background recall, metadata-only log line; on = inject the
# gated recall block into the prompt (system message, capped)
MEMORY_RECALL=shadow
# off = memory MCP tools hidden from the model; on = expose them (needs the "memory"
# entry from mcp.json.example; routed by cue words like "remember", "earlier")
MEMORY_TOOLS=off
# 1 = send a copy of every completed turn to the service
MEMORY_DUAL_WRITE=1
# Short timeouts (seconds) so a slow/down service never delays a chat turn
MEMORY_RECALL_TIMEOUT=2.5
MEMORY_APPEND_TIMEOUT=3
MEMORY_TOOL_TIMEOUT=5
