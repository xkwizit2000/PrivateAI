# Copy to .env and fill in real values:
#   cp .env.example .env

# --- Required ---
# From @BotFather (/newbot)
TELEGRAM_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# From @userinfobot (numeric Telegram user id)
ALLOWED_USER_ID=123456789

# --- Ollama ---
# Model tag as shown by `ollama list`
OLLAMA_MODEL=qwen2.5-coder:7b
# Local Ollama, or remote GPU host
OLLAMA_HOST=http://127.0.0.1:11434
# Hard timeout for a single Ollama chat call (seconds)
OLLAMA_TIMEOUT_SECONDS=180
# Warn in logs this often while still waiting for a chat response
OLLAMA_STUCK_WARN_SECONDS=30
# 0 = disable model thinking/reasoning (faster); 1 = enable
OLLAMA_THINK=0

# --- MCP tools ---
# Path to local MCP server config (gitignored)
MCP_CONFIG_PATH=/home/jthornto/Documents/projects/PrivateAI/mcp.json
# Max model↔tool loops per user message
MAX_TOOL_ITERATIONS=8
# 1 = hide write/edit/move/create tools (recommended); 0 = allow them
MCP_READONLY=1

# --- Durable conversation memory ---
# Per-chat transcript + rolling summary directory
MEMORY_DIR=/home/jthornto/Documents/projects/PrivateAI/data/sessions
# How many recent user/assistant turns to inject into each prompt
MEMORY_RECENT_TURNS=4
# Summarize to disk after this many completed turns
MEMORY_SUMMARIZE_EVERY=6
# Soft character budget for summary + recent turns in the prompt
MEMORY_MAX_CONTEXT_CHARS=12000

# --- Conversation RAG ---
# 1 = retrieve relevant older turns via embeddings; 0 = disable
RAG_ENABLED=1
# Per-session SQLite vector store directory
RAG_DIR=/home/jthornto/Documents/projects/PrivateAI/data/rag
# Embedding model on the same OLLAMA_HOST (ollama pull nomic-embed-text)
RAG_EMBED_MODEL=nomic-embed-text
# How many past chunks to inject into each prompt
RAG_TOP_K=4
# Soft character budget for retrieved snippets
RAG_MAX_CONTEXT_CHARS=4000
# Drop weak cosine matches below this score
RAG_MIN_SCORE=0.25
